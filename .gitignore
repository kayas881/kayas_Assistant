# ===========================
# Kayas AI Assistant .gitignore
# ===========================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# Virtual Environment
.venv/
venv/
ENV/
env/

# Environment variables (SECRETS!)
.env
.env.local
.env.*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# ===========================
# Kayas-specific
# ===========================

# Agent database & state
.agent/

# Artifacts (test outputs, screenshots)
artifacts/

# Debug screenshots
debug_screens/

# Logs
logs/
*.log

# Test files
test_*.py
test_*.txt
test_*.png
test_*.mp3
test_*.wav

# Jupyter notebooks (except training)
*.ipynb
!brain_training/*.ipynb

# Voice/audio cache
*.mp3
*.wav
!brain_training/**/*.mp3

# ===========================
# Documentation (generated)
# ===========================

# Keep only README files
*.md
!README.md
!**/README.md

# Generated docs
docs/_build/
site/

# ===========================
# OS & misc
# ===========================

.DS_Store
Thumbs.db
desktop.ini

# Temp files
*.tmp
*.temp
*.bak

# ===========================
# Models & large files
# ===========================

# Whisper/ML models (downloaded at runtime)
models/
*.bin

# Large model files (upload to HuggingFace instead)
*.safetensors
brain_training/final_adapter/adapter_model.safetensors

# HuggingFace cache
.cache/

